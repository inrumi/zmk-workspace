#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    zip_temp_mouse: zip_temp_mouse {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;

        /* Don't switch if typing was detected within the last 150ms */
        require-prior-idle-ms = <150>;

        /*
         * Allowed keys that will KEEP you in the MOUSE layer.
         */
        excluded-positions = <
            RT0 RM0
        >;
    };
};

/* Attach to right-hand trackball listener (Central) */
&trackball_central_listener {
    input-processors = <&zip_temp_mouse MOUSE 5000>, <&zip_central_ball>;
};
